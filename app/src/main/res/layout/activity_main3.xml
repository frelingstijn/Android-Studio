<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF596"
    tools:context=".MainActivity3">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity3"
        tools:layout_editor_absoluteX="-37dp"
        tools:layout_editor_absoluteY="16dp">

        <EditText
            android:id="@+id/createemail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:ems="10"
            android:hint="enter email"
            android:inputType="text|textEmailAddress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/createpassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="enter password"
            android:inputType="text|textPassword"
            app:layout_constraintEnd_toEndOf="@+id/createemail"
            app:layout_constraintStart_toStartOf="@+id/createemail"
            app:layout_constraintTop_toBottomOf="@+id/createemail" />

        <EditText
            android:id="@+id/homeaddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="home address"
            android:inputType="text|textPostalAddress"
            app:layout_constraintEnd_toEndOf="@+id/createpassword"
            app:layout_constraintStart_toStartOf="@+id/createpassword"
            app:layout_constraintTop_toBottomOf="@+id/createpassword" />

        <EditText
            android:id="@+id/firstname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="first name"
            android:inputType="text|textPersonName|textCapWords"
            app:layout_constraintEnd_toEndOf="@+id/homeaddress"
            app:layout_constraintStart_toStartOf="@+id/homeaddress"
            app:layout_constraintTop_toBottomOf="@+id/homeaddress" />

        <EditText
            android:id="@+id/lastname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="last name"
            android:inputType="text|textPersonName|textCapWords"
            app:layout_constraintEnd_toEndOf="@+id/firstname"
            app:layout_constraintStart_toStartOf="@+id/firstname"
            app:layout_constraintTop_toBottomOf="@+id/firstname" />

        <EditText
            android:id="@+id/age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="age"
            android:inputType="number"
            app:layout_constraintEnd_toEndOf="@+id/lastname"
            app:layout_constraintStart_toStartOf="@+id/lastname"
            app:layout_constraintTop_toBottomOf="@+id/lastname" />

        <EditText
            android:id="@+id/creditcardnumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="credit card number"
            android:inputType="number"
            app:layout_constraintEnd_toEndOf="@+id/age"
            app:layout_constraintStart_toStartOf="@+id/age"
            app:layout_constraintTop_toBottomOf="@+id/age" />

        <EditText
            android:id="@+id/creditcardcontrolnumber"
            android:layout_width="225dp"
            android:layout_height="48dp"
            android:ems="10"
            android:hint="credit card control number"
            android:inputType="number"
            app:layout_constraintEnd_toEndOf="@+id/creditcardnumber"
            app:layout_constraintStart_toStartOf="@+id/creditcardnumber"
            app:layout_constraintTop_toBottomOf="@+id/creditcardnumber" />

        <EditText
            android:id="@+id/phonenumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="phone number"
            android:inputType="number"
            app:layout_constraintEnd_toEndOf="@+id/creditcardcontrolnumber"
            app:layout_constraintStart_toStartOf="@+id/creditcardcontrolnumber"
            app:layout_constraintTop_toBottomOf="@+id/creditcardcontrolnumber" />

        <Button
            android:id="@+id/confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:backgroundTint="#FF9C73"
            android:text="confirm"
            app:layout_constraintEnd_toEndOf="@+id/phonenumber"
            app:layout_constraintStart_toStartOf="@+id/phonenumber"
            app:layout_constraintTop_toBottomOf="@+id/phonenumber" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>